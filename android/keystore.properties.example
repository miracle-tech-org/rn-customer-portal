# Copy this file to: android/keystore.properties
# Then fill in your real passwords. Do NOT commit keystore.properties.
#
# Put the keystore file in android/app/ (same folder as build.gradle), e.g.:
#   android/app/customer-portal-upload.keystore
#
# Create the keystore once (from android/app):
#   keytool -genkeypair -v -storetype PKCS12 -keystore customer-portal-upload.keystore -alias customer-portal -keyalg RSA -keysize 2048 -validity 10000

MYAPP_UPLOAD_STORE_FILE=customer-portal-upload.keystore
MYAPP_UPLOAD_KEY_ALIAS=customer-portal
MYAPP_UPLOAD_STORE_PASSWORD=your-store-password
MYAPP_UPLOAD_KEY_PASSWORD=your-key-password
